    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "MATRIX_PATH = \"GSE157103_series_matrix.txt\"\n",
        "TPM_PATH = \"GSE157103_genes.tpm.tsv\"\n",
        "MIN_TPM = 1          # a gene counts as \"expressed\" in a sample if TPM >= this\n",
        "MIN_FRACTION = 0.10  # keep genes expressed in at least 10% of samples\n",
        "TOP_N_GENES = 2000   # keep the N most variable genes (None = keep all)\n",
        "\n",
        "# 1. READ CLINICAL DATA\n",
        "patients, gsm_ids, short_ids = [], [], []\n",
        "info = {}\n",
        "with open(MATRIX_PATH) as f:\n",
        "    for line in f:\n",
        "        parts = line.rstrip(\"\\n\").split(\"\\t\")\n",
        "        label = parts[0]\n",
        "        values = [v.strip('\"') for v in parts[1:]]\n",
        "        if label == \"!Sample_title\":\n",
        "            patients = values\n",
        "        elif label == \"!Sample_geo_accession\":\n",
        "            gsm_ids = values\n",
        "        elif label == \"!Sample_description\" and not short_ids:\n",
        "            short_ids = values            # first description line: C1, C2, ... NC26\n",
        "        elif label == \"!Sample_characteristics_ch1\":\n",
        "            name = values[0].split(\":\")[0]\n",
        "            if name in (\"icu\", \"Sex\", \"age (years)\"):\n",
        "                info[name] = [v.split(\":\", 1)[1].strip() for v in values]\n",
        "\n",
        "clinical = pd.DataFrame(info, index=patients)          # patients as rows for now\n",
        "clinical = clinical.rename(columns={\"Sex\": \"gender\", \"age (years)\": \"age\"})\n",
        "clinical[\"covid\"] = [0 if p.startswith(\"NONCOVID\") else 1 for p in patients]\n",
        "\n",
        "# 2. READ EXPRESSION DATA\n",
        "expr = pd.read_csv(TPM_PATH, sep=\"\\t\", index_col=0)    # first column = gene symbols\n",
        "print(\"Expression table:\", expr.shape)\n",

        "\n",
        "# rename expression columns to patient names: try each naming scheme, keep the best\n",
        "candidates = {\n",
        "    \"short id (C1, NC1...)\": dict(zip(short_ids, patients)),\n",
        "    \"GSM id\": dict(zip(gsm_ids, patients)),\n",
        "    \"patient name\": {p: p for p in patients},\n",
        "}\n",
        "best = max(candidates, key=lambda k: sum(c in candidates[k] for c in expr.columns))\n",
        "mapping = candidates[best]\n",
        "print(\"Matching columns by:\", best)\n",
        "\n",
        "matched = [c for c in expr.columns if c in mapping]\n",
        "if len(matched) < len(patients):\n",
        "    print(\"WARNING: only\", len(matched), \"of\", len(patients), \"samples matched\")\n",
        "expr = expr[matched].rename(columns=mapping)\n",
        "expr = expr[clinical.index]                  # same patient order as the clinical table\n",
        "\n",
        "# 3. CLEAN CLINICAL DATA\n",
        "clinical[\"age\"] = clinical[\"age\"].replace(\">89\", \"90\")\n",
        "clinical[\"age\"] = pd.to_numeric(clinical[\"age\"], errors=\"coerce\")   # \":\" -> NaN\n",
        "clinical[\"gender\"] = clinical[\"gender\"].map({\"male\": 1, \"female\": 0})  # \"unknown\" -> NaN\n",
        "clinical[\"icu\"] = clinical[\"icu\"].map({\"yes\": 1, \"no\": 0})\n",
        "clinical[\"age\"] = clinical[\"age\"].fillna(clinical[\"age\"].median())\n",
        "clinical[\"gender\"] = clinical[\"gender\"].fillna(clinical[\"gender\"].mode()[0])\n",
        "clinical = clinical[[\"icu\", \"gender\", \"age\", \"covid\"]]\n",
        "\n",
        "# 4. CLEAN EXPRESSION DATA\n",
        "n_start = expr.shape[0]\n",
        "expr = expr.groupby(expr.index).mean()                      # merge duplicate gene symbols\n",
        "expr = expr[expr.index.notna() & (expr.index != \"\")]        # drop rows with no symbol\n",
        "expr = expr[(expr >= MIN_TPM).mean(axis=1) >= MIN_FRACTION] # drop barely-expressed genes\n",
        "expr = np.log2(expr + 1)                                    # log2 transform\n",
        "if TOP_N_GENES is not None and expr.shape[0] > TOP_N_GENES:\n",
        "    expr = expr.loc[expr.var(axis=1).nlargest(TOP_N_GENES).index]\n",
        "\n",
        "final = pd.concat([clinical.T, expr])\n",
        "name_to_short = dict(zip(patients, short_ids))\n",
        "final = final.rename(columns=name_to_short)\n",
        "pd.Series(name_to_short, name=\"short_id\").to_csv(\"patient_id_key.csv\")\n",
        "\n",
        "# z-scored version (each gene: mean 0, std 1 across patients)\n",
        "genes = expr.index\n",
        "final_scaled = final.copy()\n",
        "g = expr.T\n",
        "final_scaled.loc[genes] = ((g - g.mean()) / g.std().replace(0, 1)).T\n",
        "\n",
        "final.to_csv(\"preprocessed_log2tpm.csv\")            # rows = features, columns = patients\n",
        "final_scaled.to_csv(\"preprocessed_scaled.csv\")\n",
        "final.T.to_csv(\"preprocessed_log2tpm_patients_as_rows.csv\")\n",
        "\n",
        "final.head(19472)"
      ],
